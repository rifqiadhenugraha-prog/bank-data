<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Bank Data PPYM</title>

  <!-- PapaParse -->
  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>

  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
    }

    h2 {
      margin-bottom: 15px;
    }

    .header, .row {
      display: grid;
      grid-template-columns: 30% 70%;
      gap: 12px;
      padding: 10px;
      align-items: start;
    }

    .header {
      font-weight: bold;
      background: #f5f5f5;
      border: 1px solid #ddd;
      border-radius: 6px;
    }

    .row {
      border-bottom: 1px solid #ddd;
    }

    a {
      color: #0066cc;
      text-decoration: none;
      font-weight: bold;
    }

    a:hover {
      text-decoration: underline;
    }

    .not-found {
      margin-top: 15px;
      color: red;
    }
  </style>
</head>
<body>

<h2>📂 Bank Data PPYM</h2>

<div class="header">
  <div>PPYM</div>
  <div>File PPYM</div>
</div>

<div id="hasil">⏳ Memuat data...</div>

<script>
const SHEET_URL =
  "https://docs.google.com/spreadsheets/d/e/2PACX-1vSW6hUO5cusRkQ2Ykjw1fHSaclCsEvDwwRFSxWnaau2fV937ACKcYKMzjVJp3CQlF8mIM4jlteAEhjp/pub?output=csv";

const hasil = document.getElementById("hasil");

Papa.parse(SHEET_URL, {
  download: true,
  header: true,
  skipEmptyLines: true,
  complete: function(results) {
    const data = results.data;

    if (!data.length) {
      hasil.innerHTML = "<p class='not-found'>❌ Data kosong</p>";
      return;
    }

    hasil.innerHTML = data.map(d => `
      <div class="row">
        <div>${d["PPYM"] || "-"}</div>
        <div>
          ${
            d["File PPYM"]
              ? `<a href="${d["File PPYM"]}" target="_blank">📎 Buka File</a>`
              : "-"
          }
        </div>
      </div>
    `).join("");
  },
  error: function() {
    hasil.innerHTML =
      "<p class='not-found'>❌ Gagal mengambil data Google Sheet</p>";
  }
});
</script>

</body>
</html>
